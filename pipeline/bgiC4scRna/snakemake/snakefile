rule runDnbc:
    input:
        cf1 = lambda wildcard: df_runDnbc.at[wildcard.sample, 'cf1'],
        cf2 = lambda wildcard: df_runDnbc.at[wildcard.sample, 'cf2'],
        of1 = lambda wildcard: df_runDnbc.at[wildcard.sample, 'of1'],
        of2 = lambda wildcard: df_runDnbc.at[wildcard.sample, 'of2'],
    output:
        runDnbcFinished = resultDir + 'step2_runDnbc/' + '{sample}.finished',
    params:
        gpu = 0,
        ref = lambda wildcard: df_runDnbc.at[wildcard.sample, 'ref'],
        res = lambda wildcard: df_runDnbc.at[wildcard.sample, 'res'],
        expectcells = lambda wildcard: df_runDnbc.at[wildcard.sample, 'expectcells'],
        dnbc = lambda wildcard: df_runDnbc.at[wildcard.sample, 'dnbc'],
        sample = lambda wildcard: df_runDnbc.at[wildcard.sample, 'sample'],
    threads:32
    priority:20
    shell:
        """
    mkdir -p {params.res}
    cd {params.res}
    {params.dnbc} rna run     --cDNAfastq1 {input.cf1}     --cDNAfastq2 {input.cf2}     --oligofastq1 {input.of1}     --oligofastq2 {input.of2}     --genomeDir {params.ref}     --name sample     --threads {threads}     --expectcells {params.expectcells}     --outdir {params.res}
touch {output.runDnbcFinished}
        """


